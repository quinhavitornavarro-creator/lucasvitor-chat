# Discord Clone - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (fornecida automaticamente pelo Render/Railway)
PORT=3000

# Chave secreta para assinatura JWT (USE UMA STRING LONGA E ALEATORIA EM PRODUCAO)
JWT_SECRET=sua_chave_secreta_aqui_mude_esta_string

